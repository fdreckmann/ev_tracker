# EV Tracker — Umgebungsvariablen für docker-compose.yml
#
# Kopieren nach .env und anpassen:
#   cp .env.example .env
#
# Der Container startet als root und wechselt dann automatisch zu PUID:PGID
# (Mode B via gosu). /data wird beim Start automatisch auf PUID:PGID gesetzt.
# Es ist kein manuelles chown nötig.

# Eigene UID/GID ermitteln: id -u  /  id -g
PUID=10001
PGID=100

# Für Unraid (nobody:users):
# PUID=99
# PGID=100
